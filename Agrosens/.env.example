# =============================================================================
# AgroSens - variáveis de ambiente do Mapbox
# Copie este arquivo para .env e preencha com os seus próprios valores.
# Este arquivo é ignorado pelo git (.gitignore). Nunca commite tokens reais.
# =============================================================================

# Token público do Mapbox (acesso aos mapas/estilos).
# Obtenha em: https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=pk.seu_token_publico_do_mapbox_aqui

# Token secreto para download do SDK nativo do Mapbox (repositório Maven privado).
# Necessário apenas para compilar o projeto Android (binding Com.Mapbox.Maps.Android).
# Obtenha em: https://account.mapbox.com/ (seção "Downloads tokens")
MAPBOX_DOWNLOADS_TOKEN=sk.seu_token_de_download_do_mapbox_aqui
