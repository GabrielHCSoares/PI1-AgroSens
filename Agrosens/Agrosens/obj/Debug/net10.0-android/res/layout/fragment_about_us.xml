<RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFFFFF" xmlns:android="http://schemas.android.com/apk/res/android"><!-- Top Bar: Botão Voltar (<) --><RelativeLayout android:id="@+id/topBarAbout" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="20dp" android:paddingLeft="16dp" android:paddingRight="16dp"><TextView android:id="@+id/btnBackAbout" android:layout_width="40dp" android:layout_height="40dp" android:layout_centerVertical="true" android:text="❮" android:textColor="#00B050" android:textSize="22sp" android:gravity="center" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackgroundBorderless" /></RelativeLayout><!-- Conteúdo "Sobre nós" com scroll --><ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@id/topBarAbout" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="24dp" android:paddingRight="24dp" android:paddingTop="10dp" android:paddingBottom="40dp" android:gravity="center_horizontal"><!-- Seção 1: Sobre o AgroSens --><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sobre o AgroSens:" android:textColor="#52C480" android:textSize="20sp" android:gravity="center" android:layout_marginBottom="8dp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="O AgroSens nasceu de uma ideia clara: facilitar o dia a dia no campo através da tecnologia. Somos um sistema de monitorização rural focado na integração com dispositivos de hardware. O nosso propósito é transformar os dados físicos recolhidos por sensores espalhados pela propriedade em informações logísticas valiosas e fáceis de interpretar pelo utilizador." android:textColor="#4A4A4A" android:textSize="14sp" android:gravity="center" android:lineSpacingExtra="3dp" android:layout_marginBottom="36dp" /><!-- Seção 2: O Nosso Propósito --><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="O Nosso Propósito:" android:textColor="#52C480" android:textSize="20sp" android:gravity="center" android:layout_marginBottom="8dp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sabemos que gerir uma propriedade exige atenção a inúmeros detalhes. Por isso, o nosso principal objetivo é entregar um controlo centralizado e em tempo real sobre toda a infraestrutura. Desenvolvido a pensar nas necessidades de proprietários de fazendas, administradores rurais e gestores logísticos do campo, o AgroSens foi criado para ajudar a reduzir as perdas operacionais e a otimizar o tempo gasto na procura de equipamentos pela propriedade." android:textColor="#4A4A4A" android:textSize="14sp" android:gravity="center" android:lineSpacingExtra="3dp" android:layout_marginBottom="36dp" /><!-- Seção 3: A Nossa Equipa --><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A Nossa Equipa:" android:textColor="#52C480" android:textSize="20sp" android:gravity="center" android:layout_marginBottom="8dp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="João Francisco – Desenvolvedor do aplicativo\nGabriel Henrique – Desenvolvedor do aplicativo\nEvaldo Lemos – Desenvolvedor do aplicativo" android:textColor="#4A4A4A" android:textSize="14sp" android:gravity="center" android:lineSpacingExtra="4dp" /></LinearLayout></ScrollView></RelativeLayout>