<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_sheet"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="30dp">

        <!-- Indicador de arraste -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_drag_handle"/>

        <!-- Barra superior: voltar + título -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/imgVoltarSensor"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_marginLeft="4dp"
                android:src="@drawable/ic_chevron_right_green"
                android:rotation="180"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Adicionar sensor"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1B3A24"
                android:gravity="center"/>
        </RelativeLayout>

        <!-- ===== PASSO 1: escolher o tipo ===== -->
        <LinearLayout
            android:id="@+id/stepEscolhaTipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Escolha o tipo de sensor"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1B3A24"
                android:layout_marginBottom="12dp"/>

            <!-- Linha 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:id="@+id/cardTipoUmidade"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card_light"
                    android:padding="14dp"
                    android:layout_marginRight="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_circle_white_solid">
                        <ImageView
                            android:id="@+id/icTipoUmidade"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_humidity_green"/>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtTipoUmidade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Umidade"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1B3A24"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Umidade do solo ou ambiente (%)"
                        android:textSize="11sp"
                        android:textColor="#6B7A72"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/checkTipoUmidade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32"
                        android:visibility="gone"
                        android:gravity="center"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardTipoPorteira"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card_light"
                    android:padding="14dp"
                    android:layout_marginLeft="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_circle_white_solid">
                        <ImageView
                            android:id="@+id/icTipoPorteira"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_gate_green"/>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtTipoPorteira"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Porteira"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1B3A24"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aberta ou fechada"
                        android:textSize="11sp"
                        android:textColor="#6B7A72"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/checkTipoPorteira"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32"
                        android:visibility="gone"
                        android:gravity="center"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Linha 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardTipoAgua"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card_light"
                    android:padding="14dp"
                    android:layout_marginRight="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_circle_white_solid">
                        <ImageView
                            android:id="@+id/icTipoAgua"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_water_green"/>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtTipoAgua"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Água do gado"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1B3A24"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nível dos bebedouros (%)"
                        android:textSize="11sp"
                        android:textColor="#6B7A72"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/checkTipoAgua"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32"
                        android:visibility="gone"
                        android:gravity="center"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardTipoSilagem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card_light"
                    android:padding="14dp"
                    android:layout_marginLeft="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_circle_white_solid">
                        <ImageView
                            android:id="@+id/icTipoSilagem"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_silage_green"/>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtTipoSilagem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Silagem"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1B3A24"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Comida no silo/cocho (%)"
                        android:textSize="11sp"
                        android:textColor="#6B7A72"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/checkTipoSilagem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32"
                        android:visibility="gone"
                        android:gravity="center"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ===== PASSO 2: formulário (só nome + porcentagem de alerta) ===== -->
        <LinearLayout
            android:id="@+id/stepFormulario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nome do sensor"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1B3A24"
                android:layout_marginBottom="10dp"/>

            <EditText
                android:id="@+id/etNomeSensor"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Ex: Bebedouro do pasto 2"
                android:textColorHint="#B0BDB4"
                android:textColor="#1B3A24"
                android:textSize="14sp"
                android:background="@drawable/bg_input_field"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:inputType="textCapSentences"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/txtErroNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Campo obrigatório"
                android:textSize="11sp"
                android:textColor="#B00020"
                android:visibility="gone"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Porcentagem de alerta"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1B3A24"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="10dp"/>

            <!-- Umidade -->
            <LinearLayout
                android:id="@+id/secaoUmidade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Alertar quando ficar ABAIXO de"
                    android:textSize="14sp"
                    android:textColor="#1B3A24"/>

                <EditText
                    android:id="@+id/etLimiteUmidade"
                    android:layout_width="90dp"
                    android:layout_height="52dp"
                    android:layout_marginLeft="10dp"
                    android:text="30"
                    android:textColor="#1B3A24"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/bg_input_field"
                    android:inputType="number"
                    android:maxLength="3"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:text="%"
                    android:textSize="16sp"
                    android:textColor="#1B3A24"/>
            </LinearLayout>

            <!-- Porteira (não tem porcentagem: alerta por tempo aberta) -->
            <LinearLayout
                android:id="@+id/secaoPorteira"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Alertar se ficar aberta por mais de"
                    android:textSize="14sp"
                    android:textColor="#1B3A24"/>

                <EditText
                    android:id="@+id/etMinutosPorteira"
                    android:layout_width="90dp"
                    android:layout_height="52dp"
                    android:layout_marginLeft="10dp"
                    android:text="10"
                    android:textColor="#1B3A24"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/bg_input_field"
                    android:inputType="number"
                    android:maxLength="4"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:text="min"
                    android:textSize="16sp"
                    android:textColor="#1B3A24"/>
            </LinearLayout>

            <!-- Água do gado -->
            <LinearLayout
                android:id="@+id/secaoAgua"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Alertar quando o nível ficar ABAIXO de"
                    android:textSize="14sp"
                    android:textColor="#1B3A24"/>

                <EditText
                    android:id="@+id/etLimiteAgua"
                    android:layout_width="90dp"
                    android:layout_height="52dp"
                    android:layout_marginLeft="10dp"
                    android:text="25"
                    android:textColor="#1B3A24"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/bg_input_field"
                    android:inputType="number"
                    android:maxLength="3"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:text="%"
                    android:textSize="16sp"
                    android:textColor="#1B3A24"/>
            </LinearLayout>

            <!-- Silagem -->
            <LinearLayout
                android:id="@+id/secaoSilagem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Alertar quando ficar ABAIXO de"
                    android:textSize="14sp"
                    android:textColor="#1B3A24"/>

                <EditText
                    android:id="@+id/etLimiteSilagem"
                    android:layout_width="90dp"
                    android:layout_height="52dp"
                    android:layout_marginLeft="10dp"
                    android:text="30"
                    android:textColor="#1B3A24"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/bg_input_field"
                    android:inputType="number"
                    android:maxLength="3"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:text="%"
                    android:textSize="16sp"
                    android:textColor="#1B3A24"/>
            </LinearLayout>

            <!-- Botões do rodapé -->
            <TextView
                android:id="@+id/btnSalvarSensor"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_btn_green"
                android:text="Salvar sensor"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/btnCancelar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cancelar"
                android:textSize="15sp"
                android:textColor="#2E7D32"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
