<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Top Bar: Botão Voltar (<) + Título "Perfil" -->
    <RelativeLayout
        android:id="@+id/topBarEditProfile"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="20dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:id="@+id/btnBackEditProfile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:text="❮"
            android:textColor="#00B050"
            android:textSize="22sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Perfil"
            android:textColor="#00B050"
            android:textSize="22sp"
            android:textStyle="bold"/>

    </RelativeLayout>

    <!-- Conteúdo principal -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBarEditProfile"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingTop="10dp"
            android:paddingBottom="40dp">

            <!-- Foto do usuário com ícone de lápis de edição -->
            <FrameLayout
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="28dp">

                <ImageView
                    android:id="@+id/imgEditProfileAvatar"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:src="@drawable/user_photo"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_circle_avatar"
                    android:clipToOutline="true"/>

                <!-- Badge verde com lápis ✏ -->
                <FrameLayout
                    android:id="@+id/btnChangeAvatar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="bottom|right"
                    android:background="@drawable/bg_circle_green"
                    android:clickable="true"
                    android:focusable="true"
                    android:elevation="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="✏"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"/>
                </FrameLayout>
            </FrameLayout>

            <!-- Campo 1: Nome Completo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nome Completo"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etEditFullName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_mint"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="Joao Francisco"
                android:textColor="#00B050"
                android:textSize="15sp"
                android:inputType="textPersonName"
                android:layout_marginBottom="16dp"/>

            <!-- Campo 2: Telefone -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Telefone"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etEditPhone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_mint"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="+55 31987456363"
                android:textColor="#00B050"
                android:textSize="15sp"
                android:inputType="phone"
                android:layout_marginBottom="16dp"/>

            <!-- Campo 3: Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etEditEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_mint"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="joao@example.com"
                android:textColor="#00B050"
                android:textSize="15sp"
                android:inputType="textEmailAddress"
                android:layout_marginBottom="16dp"/>

            <!-- Campo 4: Data De Nascimento -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Data De Nascimento"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etEditBirthDate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_mint"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:hint="DD / MM /YYY"
                android:textColorHint="#52C480"
                android:textColor="#00B050"
                android:textSize="15sp"
                android:inputType="date"
                android:layout_marginBottom="32dp"/>

            <!-- Botão Atualizar Perfil -->
            <TextView
                android:id="@+id/btnUpdateProfile"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_btn_green_rounded"
                android:text="Atualizar Perfil"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"/>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
