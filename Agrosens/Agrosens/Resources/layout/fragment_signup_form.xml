<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Top Bar: Botão Voltar (<) + Título "Nova Conta" -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="20dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:id="@+id/btnBackSignUp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:text="❮"
            android:textColor="#00B050"
            android:textSize="22sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Nova Conta"
            android:textColor="#00B050"
            android:textSize="22sp"
            android:textStyle="bold"/>

    </RelativeLayout>

    <!-- Conteúdo em ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:layout_above="@+id/footerAlreadyAccount"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingTop="10dp"
            android:paddingBottom="20dp">

            <!-- Campo 1: Nome Completo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nome Completo"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_mint"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:textColor="#00B050"
                android:textSize="15sp"
                android:inputType="textPersonName"
                android:layout_marginBottom="16dp"/>

            <!-- Campo 2: Senha -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Senha"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_mint"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/etSignUpPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toLeftOf="@+id/btnToggleSignUpPassword"
                    android:background="@null"
                    android:hint="••••••••••••"
                    android:textColorHint="#52C480"
                    android:textColor="#00B050"
                    android:textSize="15sp"
                    android:inputType="textPassword"/>

                <TextView
                    android:id="@+id/btnToggleSignUpPassword"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:layout_alignParentRight="true"
                    android:text="👁"
                    android:textColor="#00B050"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"/>

            </RelativeLayout>

            <!-- Campo 3: Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etSignUpEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_mint"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:hint="example@example.com"
                android:textColorHint="#52C480"
                android:textColor="#00B050"
                android:textSize="15sp"
                android:inputType="textEmailAddress"
                android:layout_marginBottom="16dp"/>

            <!-- Campo 4: Celular -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Celular"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etSignUpPhone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_mint"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:hint="example@example.com"
                android:textColorHint="#52C480"
                android:textColor="#00B050"
                android:textSize="15sp"
                android:inputType="phone"
                android:layout_marginBottom="16dp"/>

            <!-- Campo 5: Data De Nascimento -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Data De Nascimento"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etSignUpBirthDate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_mint"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:hint="DD / MM /YYY"
                android:textColorHint="#52C480"
                android:textColor="#00B050"
                android:textSize="15sp"
                android:inputType="date"
                android:layout_marginBottom="20dp"/>

            <!-- Termos e Privacidade -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="By continuing, you agree to\nTerms of Use and Privacy Policy."
                android:textColor="#00B050"
                android:textSize="11sp"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <!-- Botão Sign Up Verde -->
            <TextView
                android:id="@+id/btnSubmitSignUp"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_btn_green_rounded"
                android:text="Sign Up"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:layout_marginBottom="16dp"/>

            <!-- ou cadastrar com (Google, Facebook, Biometria) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="or sign up with"
                android:textColor="#666666"
                android:textSize="11sp"
                android:gravity="center"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Google Icon -->
                <FrameLayout
                    android:id="@+id/btnSocialGoogle"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginRight="14dp"
                    android:background="@drawable/bg_circle_green"
                    android:clickable="true" android:focusable="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="G"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"/>
                </FrameLayout>

                <!-- Facebook Icon -->
                <FrameLayout
                    android:id="@+id/btnSocialFacebook"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginRight="14dp"
                    android:background="@drawable/bg_circle_green"
                    android:clickable="true" android:focusable="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="f"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"/>
                </FrameLayout>

                <!-- Fingerprint Icon -->
                <FrameLayout
                    android:id="@+id/btnSocialFingerprint"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_green"
                    android:clickable="true" android:focusable="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="☝"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"/>
                </FrameLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Rodapé: already have an account? Log in -->
    <LinearLayout
        android:id="@+id/footerAlreadyAccount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="already have an account? "
            android:textColor="#666666"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/btnFooterLogIn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log in"
            android:textColor="#00B050"
            android:textSize="12sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

</RelativeLayout>
