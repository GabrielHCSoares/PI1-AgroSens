<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingBottom="30dp">

	<!-- Indicador de arraste -->
	<View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_drag_handle"/>

	<!-- Título -->
	<TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Adicionar novo evento"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#1B3A24"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

	<!-- Campo: Nome do evento -->
	<EditText
        android:id="@+id/etEventName"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="Nome do evento..."
        android:textColorHint="#B0BDB4"
        android:textColor="#1B3A24"
        android:textSize="14sp"
        android:background="@drawable/bg_input_field"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:inputType="text"
        android:layout_marginBottom="12dp"/>

	<!-- Campo: Notas (multiline) -->
	<EditText
        android:id="@+id/etNotes"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:hint="Notas..."
        android:textColorHint="#B0BDB4"
        android:textColor="#1B3A24"
        android:textSize="14sp"
        android:background="@drawable/bg_input_field"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="12dp"
        android:gravity="top"
        android:inputType="textMultiLine"
        android:layout_marginBottom="12dp"/>

	<!-- Campo: Data -->
	<RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_input_field"
        android:layout_marginBottom="12dp">

		<EditText
            android:id="@+id/etDate"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Data..."
            android:textColorHint="#B0BDB4"
            android:textColor="#1B3A24"
            android:textSize="14sp"
            android:background="@null"
            android:paddingLeft="16dp"
            android:paddingRight="52dp"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none"/>

		<ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="14dp"
            android:src="@drawable/ic_calendar_green"/>
	</RelativeLayout>

	<!-- Hora de início + Hora de término -->
	<LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

		<!-- Hora de início -->
		<RelativeLayout
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginRight="8dp"
            android:background="@drawable/bg_input_field">

			<TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentLeft="true"
                android:layout_marginLeft="14dp"
                android:text="Hora de inicio"
                android:textSize="13sp"
                android:textColor="#B0BDB4"/>

			<ImageView
                android:id="@+id/btnStartTime"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="12dp"
                android:src="@drawable/ic_clock_green"
                android:clickable="true"
                android:focusable="true"/>
		</RelativeLayout>

		<!-- Hora de término -->
		<RelativeLayout
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_input_field">

			<TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentLeft="true"
                android:layout_marginLeft="14dp"
                android:text="Hora de termino"
                android:textSize="13sp"
                android:textColor="#B0BDB4"/>

			<ImageView
                android:id="@+id/btnEndTime"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="12dp"
                android:src="@drawable/ic_clock_green"
                android:clickable="true"
                android:focusable="true"/>
		</RelativeLayout>
	</LinearLayout>

	<!-- Toggle: Lembrete -->
	<LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

		<TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Lembrete"
            android:textSize="15sp"
            android:textColor="#1B3A24"/>

		<Switch
            android:id="@+id/switchReminder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:thumb="@drawable/bg_circle_white"
            android:track="@drawable/bg_switch_track_green"/>
	</LinearLayout>

	<!-- Título: Selecione a Categoria -->
	<TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selecione a Categoria"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#1B3A24"
        android:layout_marginBottom="12dp"/>

	<!-- Chips de categoria -->
	<LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

		<!-- Chip: Reunião (selecionado, borda roxa) -->
		<LinearLayout
            android:id="@+id/chipReuniao"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_chip_purple"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:layout_marginRight="10dp"
            android:clickable="true"
            android:focusable="true">

			<TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textSize="10sp"
                android:textColor="#8E64C7"
                android:layout_marginRight="6dp"/>

			<TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reunião"
                android:textSize="13sp"
                android:textColor="#1B3A24"/>
		</LinearLayout>

		<!-- Chip: Manutenção (selecionado, borda verde) -->
		<LinearLayout
            android:id="@+id/chipManutencao"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_chip_green"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:clickable="true"
            android:focusable="true">

			<TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textSize="10sp"
                android:textColor="#2E7D32"
                android:layout_marginRight="6dp"/>

			<TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="manutenção"
                android:textSize="13sp"
                android:textColor="#1B3A24"/>
		</LinearLayout>
	</LinearLayout>

	<!-- + Add new -->
	<TextView
        android:id="@+id/btnAddCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+ Add new"
        android:textSize="13sp"
        android:textColor="#2E7D32"
        android:layout_marginBottom="24dp"
        android:clickable="true"
        android:focusable="true"/>

	<!-- Botão: Criar Evento -->
	<TextView
        android:id="@+id/btnCreateEvent"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_btn_green"
        android:text="Criar Evento"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"/>

</LinearLayout>