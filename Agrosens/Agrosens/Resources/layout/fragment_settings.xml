<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Top Bar: Botão Voltar (<) -->
    <RelativeLayout
        android:id="@+id/topBarSettings"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="20dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:id="@+id/btnBackSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:text="❮"
            android:textColor="#00B050"
            android:textSize="22sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"/>

    </RelativeLayout>

    <!-- Conteúdo "Configurações" com scroll -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBarSettings"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingTop="10dp"
            android:paddingBottom="40dp"
            android:gravity="center_horizontal">

            <!-- Título -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Configurações"
                android:textColor="#52C480"
                android:textSize="20sp"
                android:gravity="center"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ajuste as preferências do aplicativo AgroSens abaixo."
                android:textColor="#4A4A4A"
                android:textSize="14sp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="36dp"/>

            <!-- Notificações -->
            <TextView
                android:id="@+id/menuNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Notificações"
                android:textColor="#1B3A24"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="16dp"
                android:layout_marginBottom="36dp"/>

            <!-- Botão Trocar senha -->
            <TextView
                android:id="@+id/btnChangePassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Trocar senha"
                android:textColor="#00B050"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="16dp"
                android:layout_marginBottom="16dp"/>

            <!-- Botão Limpar dados -->
            <TextView
                android:id="@+id/btnClearData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Limpar dados (calendário e sensores)"
                android:textColor="#D32F2F"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="16dp"/>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
